COMPOSE_PROJECT_NAME=edusense
DB_NAME=edusense
DB_OWNER_USER=edusense_owner
DB_APP_USER=edusense_app
DB_BACKUP_USER=edusense_backup
ADMIN_EMAIL=admin@example.invalid
# Files: db-owner, db-app, db-backup, admin-password, admin-totp, backup-offhost-auth.
SECRETS_DIR=./.secrets
WEB_PKI_DIR=./local-pki/web
MQTT_SERVER_PKI_DIR=./local-pki/mqtt
MQTT_WORKER_PKI_DIR=./local-pki/worker
HTTPS_BIND_ADDRESS=0.0.0.0
HTTPS_PORT=443
MQTT_BIND_ADDRESS=127.0.0.1
MQTT_PORT=8883
LOG_LEVEL=INFO
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
BACKUP_AGE_RECIPIENT=CHANGE_ME
# Optional HTTPS PUT destination. If empty, only persistent local backups are made.
BACKUP_OFFHOST_URL=
